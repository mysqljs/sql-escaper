{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/lib",
      "!**/benchmark",
      "!**/coverage-reports",
      "!**/playground",
      "!**/t.ts",
      "!**/mcr.config.ts",
      "!**/.lagune"
    ]
  },
  "javascript": {
    "globals": ["Temporal"]
  },
  "linter": {
    "enabled": true,
    "domains": {
      "astro": "none",
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "qwik": "none",
      "react": "none",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "turborepo": "none",
      "vue": "none"
    },
    "rules": {
      "preset": "all",
      "nursery": "on",
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "noImplicitCoercions": "off"
      },
      "correctness": {
        "useImportExtensions": "error",
        "noNodejsModules": "off",
        "noPrivateImports": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noBarrelFile": "error",
        "noDelete": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "security": {
        "noSecrets": "off"
      },
      "style": {
        "noDefaultExport": "error",
        "useNamingConvention": "off",
        "useBlockStatements": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useNodejsImportProtocol": "off",
        "noNestedTernary": "off",
        "noContinue": "off",
        "noExcessiveLinesPerFile": "off",
        "noIncrementDecrement": "off",
        "noMagicNumbers": "off",
        "noTernary": "off",
        "useConsistentMethodSignatures": "off",
        "useConsistentTypeDefinitions": "off",
        "useDestructuring": "off",
        "useExportsLast": "off",
        "useNumericSeparators": "off"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noShadowRestrictedNames": "off",
        "noOctalEscape": "off",
        "useGuardForIn": "off",
        "noBitwiseOperators": "off",
        "noForIn": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitType": "off",
            "useExplicitReturnType": "off",
            "noIdenticalTestTitle": "off",
            "noMisleadingReturnType": "off",
            "noUnsafeTypeAssertion": "off",
            "noUselessTypeConversion": "off",
            "useConsistentTestIt": "off",
            "useNamedCaptureGroup": "off",
            "useNullishCoalescing": "off",
            "useRegexpExec": "off",
            "useUnicodeRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": {
              "level": "error",
              "options": {
                "forceJsExtensions": true
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ]
}
